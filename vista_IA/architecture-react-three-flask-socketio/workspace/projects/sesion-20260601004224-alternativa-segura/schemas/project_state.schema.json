{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_state.schema.json",
  "title": "ProjectState",
  "type": "object",
  "required": ["project_slug", "status", "mode", "updated_at"],
  "additionalProperties": true,
  "properties": {
    "project_slug": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "preparing",
        "running",
        "verifying_scanner",
        "verifying_sandbox",
        "completed",
        "failed",
        "human_alignment_pending"
      ]
    },
    "mode": {
      "type": "string",
      "enum": ["smoke", "build", "medium", "long-run"]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
